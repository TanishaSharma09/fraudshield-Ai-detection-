# Cryptographic Secret for signing JWT Bearer tokens (Min 32 bytes)
# In production, generate with: python -c "import secrets; print(secrets.token_hex(32))"
FRAUDSHIELD_SECRET_KEY=replace_with_strong_production_random_secret_hex

# Access Token Validity (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Initial Admin Account Credentials
FRAUDSHIELD_ADMIN_USERNAME=admin
FRAUDSHIELD_ADMIN_EMAIL=admin@fraudshield.ai
FRAUDSHIELD_ADMIN_PASSWORD=Admin@FraudShield2026!

# Initial Analyst Account Credentials
FRAUDSHIELD_ANALYST_USERNAME=analyst
FRAUDSHIELD_ANALYST_EMAIL=analyst@fraudshield.ai
FRAUDSHIELD_ANALYST_PASSWORD=Analyst@FraudShield2026!

# Runtime Environment
DEBUG=True
